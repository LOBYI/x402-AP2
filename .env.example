# Copy to .env and fill in. .env is gitignored — never commit or paste private keys.

# Ethereum Sepolia RPC (public endpoint works; Alchemy/Infura is more reliable)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Facilitator: pays gas for transferWithAuthorization. Use the wallet holding Sepolia ETH.
FACILITATOR_PRIVATE_KEY=

# Payer (agent wallet): holds USDC only, needs no ETH. Generate with `npm run testnet:wallet`.
PAYER_KEY=

# Optional — merchant receiving address (default: the facilitator address, so funds return to you)
# PAY_TO=0x...

# Optional — token override (default: Circle USDC for the RPC's chain)
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
